{
  "id": "import",
  "kind": "action",
  "name": "Import",
  "purpose": "Adds many records at once from a CSV file.",
  "reversible": false,
  "rules": [
    "Import CSV only opens the import dialog: the person picks what to import and the file, can download a CSV sample, and nothing is imported before Start import.",
    "While it runs, a progress toast counts the records and the errors, with Stop import, and Import CSV stays off.",
    "When it ends, a toast says how many records came in and how many errors there were. There is no Undo."
  ],

{
  "id": "delete",
  "kind": "action",
  "name": "Delete",
  "purpose": "Removes a record from the product. Whether it can come back decides the flow: Undo when it can be undone, a question first when it cannot.",
  "reversible": false,
  "rules": [
    "Undo when it can be undone, confirm only when it cannot.",
    "When it can be undone (CRM: companies, contacts, deals, tasks, notes, tags), the click deletes at once, with no question, and a toast says it is gone with an Undo button.",
    "When it cannot be undone (Prints: customers, products, categories), the first button only asks: an AlertDialog names what goes and says it cannot be undone, with a confirm button that repeats the verb and the object, like Delete customer, and Cancel beside it.",
    "After a delete that cannot be undone, a success toast says it is deleted, with no Undo."
  ],
  "components": [
    "Button",
    "AlertDialog",
    "Toast"
  ],

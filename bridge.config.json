{
  "name": "Acme Design",
  "$schema": "https://unpkg.com/@bridge-ds/core@0.16.0/bridge.config.schema.json",
  "version": 1,
  "repo": {
    "owner": "acme-design-demo",
    "name": "bridge-demo-ds",
    "defaultBranch": "main"
  },
  "tokens": {
    "root": "packages/tokens/src",
    "include": [
      "**/*.tokens.json"
    ],
    "tiers": {
      "primitive": [
        "primitives"
      ],
      "brand": [
        "brands"
      ],
      "base": [
        "semantic/base.tokens.json"
      ],
      "semantic": [
        "semantic"
      ],
      "density": [
        "density"
      ],
      "component": [
        "components"
      ]
    },
    "layers": [
      {
        "files": "primitives/*.tokens.json"
      },
      {
        "files": "semantic/base.tokens.json"
      },
      {
        "files": "brands/{brand}.tokens.json"
      },
      {
        "files": "semantic/{theme}.tokens.json"
      },
      {
        "files": "brands/{brand}.{theme}.tokens.json",
        "optional": true
      },
      {
        "files": "density/{density}.tokens.json"
      },
      {
        "files": "components/*.tokens.json"
      }
    ]
  },
  "modes": {
    "brand": {
      "values": [
        "bridge",
        "ocean"
      ],
      "default": "bridge"
    },
    "theme": {
      "values": [
        "light",
        "dark"
      ],
      "default": "light",
      "parity": true
    },
    "density": {
      "values": [
        "comfortable",
        "compact"
      ],
      "default": "comfortable"
    }
  },
  "contrast": {
    "path": "packages/tokens/src/contrast.checks.json",
    "modes": [
      "brand",
      "theme"
    ]
  },
  "components": {
    "dir": "packages/react/src/components",
    "docsSuffix": ".docs.json",
    "styleSuffix": ".module.css",
    "reference": "Button",
    "index": "packages/react/src/index.ts"
  },
  "storybook": {
    "url": "https://bridge-storybook.floriangouloubi.com"
  },
  "docs": {
    "designLanguage": "docs/DESIGN-LANGUAGE.md",
    "guidelines": "AGENTS.md",
    "governance": "docs/GOVERNANCE.md"
  },
  "changesets": {
    "dir": ".changeset",
    "package": "@demo-ds/tokens"
  },
  "cssVar": {
    "prefix": "--",
    "separator": "-"
  },
  "governance": {
    "protectedBranches": [
      "main"
    ],
    "branchPrefix": "bridge/",
    "labels": [
      "source: mcp"
    ],
    "guardrails": [
      "AGENTS.md",
      ".github/",
      "docs/GOVERNANCE.md",
      "bridge.config.json",
      "packages/tokens/src/contrast.checks.json"
    ],
    "owners": {
      "design": [
        "peterbono"
      ],
      "tech": [
        "peterbono"
      ]
    },
    "rights": {
      "approveDesign": [
        "design"
      ],
      "approveTech": [
        "tech"
      ],
      "ship": [
        "tech"
      ]
    },
    "soloOwnerCanApproveBoth": true,
    "override": {
      "allowed": [
        "peterbono"
      ],
      "requireReason": true,
      "minReasonLength": 20
    }
  },
  "changes": "direct",
  "visualImpact": {
    "mode": "on-demand"
  },
  "products": [
    {
      "key": "library",
      "name": "Library",
      "path": "packages",
      "framework": "react",
      "default": true
    },
    {
      "key": "prints",
      "name": "Acme Prints",
      "repo": "acme-design-demo/acme-prints",
      "design": {
        "repo": "acme-design-demo/acme-prints-design",
        "preview": "https://{branch}.acme-prints-design.pages.dev"
      },
      "preview": "https://{branch}.acme-prints.pages.dev",
      "production": "https://acme-prints.pages.dev",
      "framework": "react"
    },
    {
      "key": "crm",
      "name": "Acme CRM",
      "repo": "acme-design-demo/acme-crm",
      "design": {
        "repo": "acme-design-demo/acme-crm-design",
        "preview": "https://{branch}.acme-crm-design.pages.dev"
      },
      "preview": "https://{branch}.acme-crm-demo.pages.dev",
      "production": "https://acme-crm-demo.pages.dev",
      "framework": "react",
      "screens": {
        "/#/": [
          "components/atomic-crm/dashboard/**",
          "components/atomic-crm/layout/**"
        ],
        "/#/contacts": "components/atomic-crm/contacts/**",
        "/#/companies": "components/atomic-crm/companies/**",
        "/#/deals": "components/atomic-crm/deals/**",
        "/#/tasks": "components/atomic-crm/tasks/**",
        "/#/settings": "components/atomic-crm/settings/**"
      }
    }
  ],
  "demo": {
    "viewer": "Dana",
    "role": "DS lead"
  }
}
